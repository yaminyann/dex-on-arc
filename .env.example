# Copy to .env and fill in. Never commit .env. Secrets stay on the backend (never prefix them with VITE_).

# --- Frontend (public values) ---
# Network a first-time visitor opens on: arc-testnet or arc
# VITE_DEFAULT_NETWORK=arc-testnet
# Footer links. A social link shows only when set (https only).
# VITE_SOCIAL_X=https://x.com/yourhandle
# VITE_SOCIAL_DISCORD=https://discord.gg/yourinvite
# VITE_SOCIAL_TELEGRAM=https://t.me/yourchannel
# VITE_SOCIAL_GITHUB=https://github.com/yaminyann/dex-on-arc
# VITE_DOCS_URL=
# VITE_SUPPORT_URL=
# VITE_TERMS_URL=
# VITE_PRIVACY_URL=
VITE_ORDERS_ADDRESS_ARC_TESTNET=0xa83efe842010dbd470dfe7cc210d61c4edd908aa
VITE_ORDERS_DEPLOY_TX_ARC_TESTNET=
# VITE_ORDERS_ADDRESS_ARC_MAINNET=
# VITE_ORDERS_DEPLOY_TX_ARC_MAINNET=
# Extra reviewed swap contracts the browser may send market swaps to on Arc mainnet (comma-separated)
# VITE_SWAP_TARGETS_ARC=

# --- RPC ---
RPC_URL_Arc_Testnet=https://rpc.testnet.arc.io
# RPC_URL_Arc=https://rpc.mainnet.arc.io,https://your-second-provider.example
KEEPER_WS_URL=wss://rpc.testnet.arc.io

# --- Backend ---
API_PORT=3001
ADMIN_TOKEN=
TRUSTED_PROXY_HOPS=0
# ALLOWED_ORIGINS=https://app.example.com
# ZEROEX_API_KEY=
# Fee on browser market swaps, in bps of the sell amount (0 = off, max 100). Paid by the aggregator to the recipient.
# PLATFORM_FEE_BPS=30
# PLATFORM_FEE_RECIPIENT=0x...
# Optional chat model for the Agent (off when unset). Any OpenAI-compatible API; a local Ollama server costs nothing.
# AGENT_LLM_URL=http://localhost:11434/v1
# AGENT_LLM_MODEL=llama3.2:3b
# AGENT_LLM_API_KEY=
# AGENT_LLM_DAILY_CALLS=2000
# GATEWAY_PROVIDERS=0x,kyber,test-router,test-router-b
# ALERT_WEBHOOK_URL=

# --- Keeper (testnet uses the throwaway deployer key; mainnet uses its own dedicated low-balance key) ---
# KEEPER_ENABLED=true
KEEPER_NETWORK=arc-testnet
KEEPER_INTERVAL_MS=5000
# KEEPER_PRIVATE_KEY=
# KEEPER_PRIVATE_KEY_FILE=/run/secrets/keeper_key
# KEEPER_ROLE=standby
# KEEPER_BACKOFF_BASE_MS=5000
# KEEPER_BACKOFF_MAX_MS=60000

# --- Indexer ---
INDEXER_ENABLED=true
INDEXER_NETWORK=arc-testnet
INDEXER_INTERVAL_MS=5000
# DATABASE_URL=postgres://user:pass@host:5432/arc_terminal

# --- Testnet harness scripts only ---
# TESTNET_DEPLOYER_PRIVATE_KEY=
